<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Build-time CSS compiler for EggLedger.Web: scans .razor/.html markup for utility/component class tokens and compiles wwwroot/tailwind.css via MonorailCss + EggIdentity.Styles, replacing the vendored Tailwind CLI.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonorailCss" Version="0.1.3" />
    <PackageReference Include="EggIdentity.Styles" Version="1.1.0" />
  </ItemGroup>

</Project>
