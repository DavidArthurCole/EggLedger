@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

<ModalOverlay @ref="_modal" OnClose="Close" ContainerClass="account-settings-dialog p-4 border border-gray-600 rounded-lg bg-darker text-gray-300 shadow-2xl w-fit min-w-[28rem] max-w-[min(90vw,40rem)] mx-4 max-h-[85vh] overflow-y-auto">
    <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-bold text-gray-300">Account Settings</h2>
        <CloseButton OnClick="Close" Class="text-gray-500 hover:text-gray-300" IconClass="w-4 h-4"/>
    </div>

    @if (Services.GetService<IProfilePanelSlot>() is { } profileSlot) {
        @profileSlot.Render()

        <hr class="mt-1rem mb-1rem w-full"/>
    }

    <CloudSyncPanel/>

    <hr class="mt-1rem mb-1rem w-full"/>

    <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-0_5rem">My accounts</div>

    <AccountDataPanel Accounts="Accounts" Changed="OnChangedAsync" Fetching="Fetching"/>
</ModalOverlay>

@code {
    private ModalOverlay? _modal;

    [Parameter] public IReadOnlyList<DatabaseAccount> Accounts { get; set; } = [];
    [Parameter] public AccountDataPanel.FetchingCard? Fetching { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    public void Open() {
        _modal?.Open();
        StateHasChanged();
    }

    private void Close() {
        _modal?.Close();
    }

    private async Task OnChangedAsync() {
        await Changed.InvokeAsync();
    }

}
