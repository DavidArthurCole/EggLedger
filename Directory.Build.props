<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Authors>DavidArthurCole</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

    <PropertyGroup>
    <EggLedgerVersion>3.4.0-beta.8</EggLedgerVersion>
    <EggLedgerVersionCore>$(EggLedgerVersion.Split('-')[0])</EggLedgerVersionCore>
    <Version>$(EggLedgerVersion)</Version>
    <AssemblyVersion>$(EggLedgerVersionCore).0</AssemblyVersion>
    <FileVersion>$(EggLedgerVersionCore).0</FileVersion>
    <InformationalVersion>$(EggLedgerVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
